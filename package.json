{
  "name": "blood-aidx-api",
  "version": "0.1.0",
  "author": "Polas Chandra Barmon",
  "description": "Find a blood donor or donate blood",
  "homepage": "https://github.com/devpolas/blood-aidx-api#readme",
  "bugs": {
    "url": "https://github.com/devpolas/blood-aidx-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devpolas/blood-aidx-api.git"
  },
  "keywords": [
    "blood",
    "donate",
    "aid",
    "blood-donate"
  ],
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "tsx watch src/server.ts",
    "start:prod": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "npm run typecheck && npm run lint",
    "verify": "npm run check && npm run build",
    "contract:emit": "prisma contract emit",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "db:schema": "prisma db schema",
    "migration:plan": "prisma migration plan",
    "migration:status": "prisma migration status",
    "db:migrate": "prisma db migrate",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "bowser": "^2.14.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "redis": "^6.2.1",
    "slugify": "^1.6.9",
    "stripe": "^22.6.1",
    "temporal-polyfill": "^1.0.4",
    "tsup": "^8.5.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "oxlint": "^1.81.0",
    "prisma": "^8.0.0-rc.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "msgpackr-extract@3.0.4": true,
    "workerd@1.20260704.1": true
  }
}
