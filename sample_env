# Application

NODE_ENV = development
PORT = 8000
SOCKET_PORT = 8001
LOGO=https://res.cloudinary.com/db7ar6ox9/image/upload/v1788379761/drop_of_blood_kdhezs.png

# Frontend URLs (comma-separated)

APP_URL = http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# Public website URL

WEBSITE_URL = http://localhost:3000

# Database

DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=require

# JWT Authentication

JWT_ACCESS_SECRET = your_access_token_secret
JWT_ACCESS_EXPIRES_IN=1d

JWT_REFRESH_SECRET = your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN = 30d

# Authentication provider

AUTH_CREDENTIAL_PROVIDER=credential

# Database session lifetime

AUTH_SESSION_DURATION_DAYS=30

# Password reset token lifetime

AUTH_PASSWORD_RESET_DURATION_MINUTES=15

# Redis user cache lifetime

AUTH_USER_CACHE_DURATION_MINUTES=15

# Stripe

STRIPE_SECRET = your_stripe_secret_key
STRIPE_WEBHOOK_SECRET = your_stripe_webhook_secret_key

# Email (Nodemailer / SMTP)

NODEMAILER_SERVICE = gmail
NODEMAILER_USER = your-email@example.com
NODEMAILER_APP_PASSWORD = your-app-password

SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465

# Google OAuth

GOOGLE_CLIENT_ID = your_google_client_id
GOOGLE_CLIENT_SECRET = your_google_client_secret
GOOGLE_CALLBACK_URL = http://localhost:8000/api/v1/auth/google/callback

# Session

SESSION_SECRET = your_session_secret

# Redis

REDIS_URL=your_redis_database_url

# Cloudinary

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_secret
