{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["typescript", "unicorn", "oxc"],

  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },

  "rules": {
    "typescript/no-unused-vars": "error"
  },

  "env": {
    "builtin": true,
    "node": true
  }
}
