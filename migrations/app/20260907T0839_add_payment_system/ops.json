  {
    "id": "table.payments",
    "label": "Create table \"payments\"",
    "summary": "Creates table \"payments\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "payments"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"payments\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"payments\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"payments\"",
        "sql": "CREATE TABLE \"public\".\"payments\" (\n  \"amount\" int4 NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"currency\" text DEFAULT 'usd' NOT NULL,\n  \"description\" text,\n  \"donorId\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"metadata\" json,\n  \"paidAt\" timestamptz,\n  \"payerId\" text NOT NULL,\n  \"provider\" text DEFAULT 'stripe' NOT NULL,\n  \"refundedAt\" timestamptz,\n  \"status\" text DEFAULT 'pending' NOT NULL,\n  \"stripeCheckoutSessionId\" text,\n  \"stripeCustomerId\" text,\n  \"stripePaymentIntentId\" text,\n  \"type\" text DEFAULT 'donor_coffee' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"payments_provider_check_ae06b403\" CHECK (\"provider\" IN ('stripe')),\n  CONSTRAINT \"payments_status_check_2c696f68\" CHECK (\"status\" IN ('pending', 'processing', 'succeeded', 'failed', 'cancelled', 'refunded', 'partially_refunded')),\n  CONSTRAINT \"payments_type_check_6e9bcc94\" CHECK (\"type\" IN ('donor_coffee'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"payments\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"payments\""
        ]
      }
    ]
  },
