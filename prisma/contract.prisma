// use prisma-next

// ENUMS
enum UserRole {
  @@type("pg/text@1")

  DONOR = "donor"
  RECIPIENT = "recipient"
  VOLUNTEER = "volunteer"
  HOSPITAL = "hospital"
  BLOOD_BANK = "blood_bank"
  MODERATOR = "moderator"
  ADMIN = "admin"
}

enum Gender {
  @@type("pg/text@1")

  MALE = "male"
  FEMALE = "female"
  OTHER = "other"
  PREFER_NOT_TO_SAY = "prefer_not_to_say"
}

enum BloodGroup {
  @@type("pg/text@1")

  A_POSITIVE = "a_positive"
  A_NEGATIVE = "a_negative"
  B_POSITIVE = "b_positive"
  B_NEGATIVE = "b_negative"
  AB_POSITIVE = "ab_positive"
  AB_NEGATIVE = "ab_negative"
  O_POSITIVE = "o_positive"
  O_NEGATIVE = "o_negative"
}

enum Priority {
  @@type("pg/text@1")

  LOW = "low"
  HIGH = "high"
  URGENT = "urgent"
}

enum DonorAvailability {
  @@type("pg/text@1")

  AVAILABLE = "available"
  UNAVAILABLE = "unavailable"
  TEMPORARILY_UNAVAILABLE = "temporarily_unavailable"
}

enum BloodRequestStatus {
  @@type("pg/text@1")

  OPEN = "open"
  PARTIALLY_FULFILLED = "partially_fulfilled"
  FULFILLED = "fulfilled"
  CANCELLED = "cancelled"
  EXPIRED = "expired"
}

enum RequestResponseStatus {
  @@type("pg/text@1")

  PENDING = "pending"
  ACCEPTED = "accepted"
  DECLINED = "declined"
  CANCELLED = "cancelled"
  COMPLETED = "completed"
}

enum DonationStatus {
  @@type("pg/text@1")

  PENDING = "pending"
  VERIFIED = "verified"
  REJECTED = "rejected"
  CANCELLED = "cancelled"
}

enum OrganizationType {
  @@type("pg/text@1")

  HOSPITAL = "hospital"
  BLOOD_BANK = "blood_bank"
  CLINIC = "clinic"
  NGO = "ngo"
  OTHER = "other"
}

enum OrganizationStatus {
  @@type("pg/text@1")

  PENDING = "pending"
  ACTIVE = "active"
  VERIFIED = "verified"
  SUSPENDED = "suspended"
  REJECTED = "rejected"
}

enum OrganizationMemberRole {
  @@type("pg/text@1")

  ADMIN = "admin"
  STAFF = "staff"
  VERIFIER = "verifier"
}

enum NotificationType {
  @@type("pg/text@1")

  BLOOD_REQUEST = "blood_request"
  DONATION = "donation"
  DONATION_VERIFIED = "donation_verified"
  CERTIFICATE = "certificate"
  MILESTONE = "milestone"
  MESSAGE = "message"
  SYSTEM = "system"
}

enum ConversationType {
  @@type("pg/text@1")

  DIRECT = "direct"
  BLOOD_REQUEST = "blood_request"
  ORGANIZATION = "organization"
}

enum ReviewStatus {
  @@type("pg/text@1")

  PENDING = "pending"
  PUBLISHED = "published"
  HIDDEN = "hidden"
  REJECTED = "rejected"
}

enum ReportType {
  @@type("pg/text@1")

  USER = "user"
  BLOOD_REQUEST = "blood_request"
  DONATION = "donation"
  ORGANIZATION = "organization"
  MESSAGE = "message"
  REVIEW = "review"
}

enum ReportStatus {
  @@type("pg/text@1")

  PENDING = "pending"
  REVIEWING = "reviewing"
  RESOLVED = "resolved"
  REJECTED = "rejected"
}

enum AuditAction {
  @@type("pg/text@1")

  CREATE = "create"
  UPDATE = "update"
  DELETE = "delete"
  LOGIN = "login"
  LOGOUT = "logout"
  VERIFY = "verify"
  SUSPEND = "suspend"
  BAN = "ban"
  RESTORE = "restore"
}

enum PaymentStatus {
  @@type("pg/text@1")

  PENDING = "pending"
  PROCESSING = "processing"
  SUCCEEDED = "succeeded"
  FAILED = "failed"
  CANCELLED = "cancelled"
  REFUNDED = "refunded"
  PARTIALLY_REFUNDED = "partially_refunded"
}

enum PaymentType {
  @@type("pg/text@1")

  DONOR_COFFEE = "donor_coffee"
}

enum PaymentProvider {
  @@type("pg/text@1")

  STRIPE = "stripe"
}

// USER
model User {
  id                       String                    @id @default(uuid())
  name                     String
  email                    String
  emailVerified            Boolean                   @default(false)
  image                    String?

  role                     UserRole                  @default(DONOR)
  gender                   Gender?

  banned                   Boolean                   @default(false)
  banReason                String?
  banExpires               TimestamptzString?

  locationId               String?

  createdAt                TimestamptzString         @default(now())
  updatedAt                temporal.updatedAt()

  // Relations
  location                 Location?                 @relation(fields:[locationId], references:[id], onDelete: SetNull)

  profile                  UserProfile?

  donor                    DonorProfile?

  sessions                 Session[]

  accounts                 Account[]

  bloodRequests            BloodRequest[]            @relation("RequestRequester")

  donationsVerified        BloodDonation[]           @relation("DonationVerifier")

  notifications            Notification[]

  conversationParticipants ConversationParticipant[]

  messages                 Message[]                 @relation("MessageSender")

  reviewsGiven             Review[]                  @relation("ReviewAuthor")

  reviewsReceived          Review[]                  @relation("ReviewTarget")

  organizationsOwned       Organization[]            @relation("OrganizationOwner")

  organizationMemberships  OrganizationMember[]

  organizationsVerified    Organization[]            @relation("OrganizationVerifier")

  reportsGiven             Report[]                  @relation("ReportReporter")

  reportsResolved          Report[]                  @relation("ReportResolver")

  milestones               UserMilestone[]

  auditLogs                AuditLog[]

  paymentsMade             Payment[]                 @relation("PaymentPayer")

  // Indexes
  @@unique([email])

  @@index([locationId])
  @@index([role])
  @@index([banned])

  @@map("users")
}

// SESSION
model Session {
  id             String               @id @default(uuid())

  token          String

  userId         String

  expiresAt      TimestamptzString

  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  createdAt      TimestamptzString    @default(now())
  updatedAt      temporal.updatedAt()

  user           User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([token])

  @@index([userId])
  @@index([expiresAt])

  @@map("sessions")
}

// ACCOUNT
model Account {
  id                    String               @id @default(uuid())

  userId                String

  providerId            String
  accountId             String

  password              String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  scope                 String?

  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?

  createdAt             TimestamptzString    @default(now())
  updatedAt             temporal.updatedAt()

  user                  User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([providerId, accountId])

  @@index([userId])
  @@index([providerId])

  @@map("accounts")
}

// USER PROFILE
model UserProfile {
  id          String               @id @default(uuid())

  userId      String               @unique

  phone       String?
  dateOfBirth TimestamptzString?
  bio         String?

  createdAt   TimestamptzString    @default(now())
  updatedAt   temporal.updatedAt()

  user        User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@map("user_profiles")
}

// LOCATION
model Location {
  id            String               @id @default(uuid())

  latitude      String?
  longitude     String?

  country       String
  division      String
  district      String
  city          String
  village       String
  postalCode    String

  addressLine   String?

  createdAt     TimestamptzString    @default(now())
  updatedAt     temporal.updatedAt()

  users         User[]

  organizations Organization[]

  bloodRequests BloodRequest[]

  donations     BloodDonation[]

  @@index([country])
  @@index([division])
  @@index([district])
  @@index([city])
  @@index([postalCode])

  @@index([country, division, district, city])

  @@map("locations")
}

// DONOR PROFILE
model DonorProfile {
  id                   String                 @id @default(uuid())

  userId               String                 @unique

  bloodGroup           BloodGroup

  availability         DonorAvailability      @default(AVAILABLE)

  lastDonationAt       TimestamptzString?

  totalDonations       Int                    @default(0)

  isEligible           Boolean                @default(true)

  eligibilityCheckedAt TimestamptzString?

  createdAt            TimestamptzString      @default(now())
  updatedAt            temporal.updatedAt()

  user                 User                   @relation(fields:[userId], references:[id], onDelete: Cascade)

  donations            BloodDonation[]

  responses            BloodRequestResponse[]

  paymentsReceived     Payment[]              @relation("DonorPayments")

  @@index([bloodGroup])
  @@index([availability])
  @@index([isEligible])

  @@index([bloodGroup, availability, isEligible])

  @@map("donor_profiles")
}

// BLOOD REQUEST
model BloodRequest {
  id             String                 @id @default(uuid())

  requesterId    String

  locationId     String?

  bloodGroup     BloodGroup

  unitsRequired  Int
  unitsFulfilled Int                    @default(0)

  priority       Priority               @default(LOW)

  status         BloodRequestStatus     @default(OPEN)

  patientName    String?
  patientAge     Int?

  hospitalName   String?

  requiredAt     TimestamptzString?
  expiresAt      TimestamptzString?

  description    String?

  createdAt      TimestamptzString      @default(now())
  updatedAt      temporal.updatedAt()

  requester      User                   @relation("RequestRequester", fields:[requesterId], references:[id], onDelete: Cascade)

  location       Location?              @relation(fields:[locationId], references:[id], onDelete: SetNull)

  responses      BloodRequestResponse[]

  donations      BloodDonation[]

  @@index([requesterId])
  @@index([locationId])
  @@index([bloodGroup])
  @@index([status])
  @@index([priority])
  @@index([expiresAt])

  @@index([bloodGroup, status, priority])

  @@map("blood_requests")
}

// BLOOD REQUEST RESPONSE
model BloodRequestResponse {
  id          String                @id @default(uuid())

  requestId   String
  donorId     String

  status      RequestResponseStatus @default(PENDING)

  message     String?

  respondedAt TimestamptzString     @default(now())
  acceptedAt  TimestamptzString?
  completedAt TimestamptzString?

  createdAt   TimestamptzString     @default(now())
  updatedAt   temporal.updatedAt()

  request     BloodRequest          @relation(fields:[requestId], references:[id], onDelete: Cascade)

  donor       DonorProfile          @relation(fields:[donorId], references:[id], onDelete: Cascade)

  @@unique([requestId, donorId])

  @@index([requestId])
  @@index([donorId])
  @@index([status])

  @@index([requestId, status])

  @@map("blood_request_responses")
}

// BLOOD DONATION
model BloodDonation {
  id              String               @id @default(uuid())
  donorId         String
  requestId       String?
  organizationId  String?
  locationId      String?
  donationNumber  String               @unique
  bloodGroup      BloodGroup
  units           Int                  @default(1)

  donatedAt       TimestamptzString

  status          DonationStatus       @default(PENDING)

  verifiedAt      TimestamptzString?

  verifiedById    String?

  rejectionReason String?

  notes           String?

  createdAt       TimestamptzString    @default(now())
  updatedAt       temporal.updatedAt()

  donor           DonorProfile         @relation(fields:[donorId], references:[id], onDelete: Cascade)

  request         BloodRequest?        @relation(fields:[requestId], references:[id], onDelete: SetNull)

  organization    Organization?        @relation(fields:[organizationId], references:[id], onDelete: SetNull)

  location        Location?            @relation(fields:[locationId], references:[id], onDelete: SetNull)

  verifiedBy      User?                @relation("DonationVerifier", fields:[verifiedById], references:[id], onDelete: SetNull)

  certificate     DonationCertificate?

  @@unique([donorId, donationNumber])

  @@index([donorId])
  @@index([requestId])
  @@index([organizationId])
  @@index([locationId])
  @@index([status])
  @@index([donatedAt])

  @@index([donorId, status, donatedAt])

  @@map("blood_donations")
}

// DONATION CERTIFICATE
model DonationCertificate {
  id               String            @id @default(uuid())
  donationId       String            @unique
  certificateNo    String            @unique
  verificationCode String            @unique
  donorName        String
  bloodGroup       BloodGroup
  donationNumber   Int

  donatedAt        TimestamptzString
  issuedAt         TimestamptzString @default(now())
  certificateUrl   String?

  createdAt        TimestamptzString @default(now())

  donation         BloodDonation     @relation(fields:[donationId], references:[id], onDelete: Cascade)

  @@map("donation_certificates")
}

// ORGANIZATION
model Organization {
  id             String               @id @default(uuid())
  ownerId        String
  locationId     String?
  verifiedById   String?
  name           String
  slug           String               @unique

  type           OrganizationType
  status         OrganizationStatus   @default(PENDING)
  description    String?

  logoUrl        String?
  coverUrl       String?

  phone          String?
  email          String?
  website        String?

  registrationNo String?

  verifiedAt     TimestamptzString?

  createdAt      TimestamptzString    @default(now())
  updatedAt      temporal.updatedAt()

  owner          User                 @relation("OrganizationOwner", fields:[ownerId], references:[id], onDelete: Restrict)

  location       Location?            @relation(fields:[locationId], references:[id], onDelete: SetNull)

  verifiedBy     User?                @relation("OrganizationVerifier", fields:[verifiedById], references:[id], onDelete: SetNull)

  members        OrganizationMember[]

  donations      BloodDonation[]

  reviews        Review[]

  @@index([ownerId])
  @@index([locationId])
  @@index([verifiedById])
  @@index([type])
  @@index([status])

  @@index([type, status])

  @@map("organizations")
}

// ORGANIZATION MEMBERS
model OrganizationMember {
  id             String                 @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(STAFF)

  createdAt      TimestamptzString      @default(now())
  updatedAt      temporal.updatedAt()

  organization   Organization           @relation(fields:[organizationId], references:[id], onDelete: Cascade)

  user           User                   @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([organizationId, userId])

  @@index([userId])
  @@index([role])

  @@index([organizationId, role])

  @@map("organization_members")
}

// NOTIFICATIONS
model Notification {
  id        String               @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String

  read      Boolean              @default(false)
  readAt    TimestamptzString?

  data      Json?

  createdAt TimestamptzString    @default(now())
  updatedAt temporal.updatedAt()

  user      User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@index([userId])

  @@index([userId, read])

  @@index([userId, read, createdAt])

  @@map("notifications")
}

// CONVERSATION
model Conversation {
  id           String                    @id @default(uuid())
  type         ConversationType

  createdAt    TimestamptzString         @default(now())
  updatedAt    temporal.updatedAt()

  participants ConversationParticipant[]

  messages     Message[]

  @@index([type])

  @@map("conversations")
}

// CONVERSATION PARTICIPANT
model ConversationParticipant {
  id             String             @id @default(uuid())
  conversationId String
  userId         String

  joinedAt       TimestamptzString  @default(now())

  lastReadAt     TimestamptzString?

  conversation   Conversation       @relation(fields:[conversationId], references:[id], onDelete: Cascade)

  user           User               @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([conversationId, userId])

  @@index([userId])

  @@index([userId, lastReadAt])

  @@map("conversation_participants")
}

// MESSAGE
model Message {
  id             String               @id @default(uuid())
  conversationId String
  senderId       String
  content        String

  isEdited       Boolean              @default(false)
  editedAt       TimestamptzString?

  createdAt      TimestamptzString    @default(now())
  updatedAt      temporal.updatedAt()

  conversation   Conversation         @relation(fields:[conversationId], references:[id], onDelete: Cascade)

  sender         User                 @relation("MessageSender", fields:[senderId], references:[id], onDelete: Cascade)

  @@index([conversationId, createdAt])

  @@index([senderId])

  @@map("messages")
}

// REVIEW
model Review {
  id             String               @id @default(uuid())
  reviewerId     String
  revieweeId     String?
  organizationId String?
  rating         Int
  comment        String?
  status         ReviewStatus         @default(PENDING)

  createdAt      TimestamptzString    @default(now())
  updatedAt      temporal.updatedAt()

  reviewer       User                 @relation("ReviewAuthor", fields:[reviewerId], references:[id], onDelete: Cascade)

  reviewee       User?                @relation("ReviewTarget", fields:[revieweeId], references:[id], onDelete: SetNull)

  organization   Organization?        @relation(fields:[organizationId], references:[id], onDelete: SetNull)

  @@index([reviewerId])
  @@index([revieweeId])
  @@index([organizationId])
  @@index([status])

  @@index([organizationId, status])

  @@index([revieweeId, status])

  @@map("reviews")
}

// DONATION MILESTONE
model DonationMilestone {
  id            String               @id @default(uuid())
  name          String
  description   String
  donationCount Int                  @unique
  badgeUrl      String?

  createdAt     TimestamptzString    @default(now())
  updatedAt     temporal.updatedAt()

  users         UserMilestone[]

  @@map("donation_milestones")
}

// USER MILESTONE
model UserMilestone {
  id          String                @id @default(uuid())
  userId      String
  milestoneId String

  achievedAt  TimestamptzString     @default(now())

  user        User                  @relation(fields:[userId], references:[id], onDelete: Cascade)

  milestone   DonationMilestone     @relation(fields:[milestoneId], references:[id], onDelete: Cascade)

  certificate MilestoneCertificate?

  @@unique([userId, milestoneId])

  @@index([userId])
  @@index([milestoneId])

  @@map("user_milestones")
}

// MILESTONE CERTIFICATE
model MilestoneCertificate {
  id               String            @id @default(uuid())
  userMilestoneId  String            @unique
  certificateNo    String            @unique
  verificationCode String            @unique
  donorName        String
  donationCount    Int

  achievedAt       TimestamptzString
  issuedAt         TimestamptzString @default(now())

  certificateUrl   String?
  createdAt        TimestamptzString @default(now())

  userMilestone    UserMilestone     @relation(fields:[userMilestoneId], references:[id], onDelete: Cascade)

  @@map("milestone_certificates")
}

// REPORT
model Report {
  id           String               @id @default(uuid())
  reporterId   String
  resolvedById String?
  type         ReportType
  targetId     String
  reason       String
  description  String?

  status       ReportStatus         @default(PENDING)
  resolvedAt   TimestamptzString?

  createdAt    TimestamptzString    @default(now())
  updatedAt    temporal.updatedAt()

  reporter     User                 @relation("ReportReporter", fields:[reporterId], references:[id], onDelete: Cascade)

  resolvedBy   User?                @relation("ReportResolver", fields:[resolvedById], references:[id], onDelete: SetNull)

  @@index([reporterId])
  @@index([resolvedById])
  @@index([type, targetId])
  @@index([status])

  @@index([status, createdAt])

  @@map("reports")
}

// AUDIT LOG
model AuditLog {
  id         String            @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  TimestamptzString @default(now())

  user       User?             @relation(fields:[userId], references:[id], onDelete: SetNull)

  @@index([userId])

  @@index([entityType, entityId])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Payment {
  id                      String               @id @default(uuid())

  payerId                 String
  donorId                 String

  type                    PaymentType          @default(DONOR_COFFEE)
  provider                PaymentProvider      @default(STRIPE)
  status                  PaymentStatus        @default(PENDING)

  // Major currency unit.
  // Example: 10.50 USD = 10.50
  amount                  Float
  refundedAmount          Float                @default("0")

  currency                String               @default("usd")

  message                 String?
  description             String?

  stripePaymentIntentId   String?              @unique
  stripeCheckoutSessionId String?              @unique
  stripeCustomerId        String?

  paidAt                  TimestamptzString?
  refundedAt              TimestamptzString?

  metadata                Json?

  createdAt               TimestamptzString    @default(now())
  updatedAt               temporal.updatedAt()

  payer                   User                 @relation("PaymentPayer", fields:[payerId], references:[id], onDelete: Cascade)

  donor                   DonorProfile         @relation("DonorPayments", fields:[donorId], references:[id], onDelete: Cascade)

  @@index([payerId])
  @@index([donorId])
  @@index([status])
  @@index([type])
  @@index([provider])
  @@index([donorId, status, createdAt])
  @@index([payerId, status, createdAt])
  @@map("payments")
}
